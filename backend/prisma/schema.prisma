// ─────────────────────────────────────────────────────────────
// WINGROX DATABASE SCHEMA
// Run: npm run db:push  (to sync schema to DB)
// Run: npm run db:studio (to open visual DB browser)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USERS · accounts that can run diagnostics
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  
  // Tier they've paid for (or 'nucleus' for free users)
  tier         Tier     @default(NUCLEUS)
  
  // Stripe customer for billing
  stripeCustomerId String? @unique
  
  // Relations
  sessions     DiagnosticSession[]
  files        UploadedFile[]
  leads        AdvisorLead[]
  payments     Payment[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
  
  @@map("users")
}

enum Tier {
  NUCLEUS  // free, 15 questions
  VANGUARD // $199, 100 questions
  APEX     // book-call, white glove
}

// DIAGNOSTIC SESSION · one per user attempt
model DiagnosticSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Tier this session was started under (lock at session start)
  tier         Tier
  
  // Profile data — stored as JSON since structure mirrors frontend
  // Includes: name, industry, email, mobile, linkedin, year, chips{}, 
  //           and 12 financial overrides
  profile      Json     @default("{}")
  
  // Question answers — { Q1: 5, Q2: 3, ... }
  answers      Json     @default("{}")
  
  // Computed results cache (filled when diagnostic completes)
  results      Json?
  
  // Lifecycle
  status       SessionStatus @default(IN_PROGRESS)
  completedAt  DateTime?
  
  // Files attached to this session
  files        UploadedFile[]
  leads        AdvisorLead[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userId])
  @@map("diagnostic_sessions")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// UPLOADED FILES · pitch decks, financials etc.
model UploadedFile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sessionId    String?
  session      DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  filename     String
  mimeType     String
  sizeBytes    Int
  
  // Storage location
  storageKey   String   // local path OR S3 key
  storageDriver String  @default("local") // 'local' | 's3'
  
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([sessionId])
  @@map("uploaded_files")
}

// ADVISOR LEADS · captures every "Book strategy call" / "Email advisor" click
model AdvisorLead {
  id           String   @id @default(cuid())
  userId       String?  // optional — could be from anonymous user
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  sessionId    String?
  session      DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  // Where in the report they triggered
  context      String   // e.g. 'exec-summary', 'revenue-engine', 'simulator'
  
  // The user-supplied data
  email        String
  name         String?
  mobile       String?
  message      String?
  
  // Snapshot of master score at time of lead (for advisor context)
  masterScore  Float?
  tier         Tier?
  
  // Lead lifecycle
  status       LeadStatus @default(NEW)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([status, createdAt])
  @@map("advisor_leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

// PAYMENTS · Stripe transactions
model Payment {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripePaymentIntentId String   @unique
  stripeSessionId       String?  @unique
  
  amountCents           Int
  currency              String   @default("usd")
  tier                  Tier     // tier they bought
  
  status                PaymentStatus @default(PENDING)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
