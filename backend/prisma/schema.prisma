// ─────────────────────────────────────────────────────────────
// WINGROX DATABASE SCHEMA
// Run: npm run db:push  (to sync schema to DB)
// Run: npm run db:studio (to open visual DB browser)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USERS · accounts that can run diagnostics
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  
  // Tier they've paid for (or 'nucleus' for free users)
  tier         Tier          @default(NUCLEUS)
  
  // Expansion-specific plan (Silver/Gold/Platinum — separate from Digital Twin tiers)
  expansionTier ExpansionTier @default(SILVER)
  
  // Stripe customer for billing
  stripeCustomerId String? @unique
  
  // Relations
  sessions            DiagnosticSession[]
  expansionAssessments ExpansionAssessment[]
  matchRequests        MatchRequest[]
  files               UploadedFile[]
  leads               AdvisorLead[]
  payments            Payment[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
  
  @@map("users")
}

enum Tier {
  NUCLEUS  // free, 15 questions
  VANGUARD // $199, 100 questions
  APEX     // book-call, white glove
}

enum ExpansionTier {
  SILVER   // free — 1 assessment/month
  GOLD     // paid — 5 assessments/month
  PLATINUM // paid — unlimited assessments
}

// DIAGNOSTIC SESSION · one per user attempt
model DiagnosticSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Tier this session was started under (lock at session start)
  tier         Tier
  
  // Profile data — stored as JSON since structure mirrors frontend
  // Includes: name, industry, email, mobile, linkedin, year, chips{}, 
  //           and 12 financial overrides
  profile      Json     @default("{}")
  
  // Question answers — { Q1: 5, Q2: 3, ... }
  answers      Json     @default("{}")
  
  // Computed results cache (filled when diagnostic completes)
  results      Json?
  
  // Lifecycle
  status       SessionStatus @default(IN_PROGRESS)
  completedAt  DateTime?
  
  // Files attached to this session
  files        UploadedFile[]
  leads        AdvisorLead[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userId])
  @@map("diagnostic_sessions")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// UPLOADED FILES · pitch decks, financials etc.
model UploadedFile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sessionId    String?
  session      DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  filename     String
  mimeType     String
  sizeBytes    Int
  
  // Storage location
  storageKey   String   // local path OR S3 key
  storageDriver String  @default("local") // 'local' | 's3'
  
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([sessionId])
  @@map("uploaded_files")
}

// ADVISOR LEADS · captures every "Book strategy call" / "Email advisor" click
model AdvisorLead {
  id           String   @id @default(cuid())
  userId       String?  // optional — could be from anonymous user
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  sessionId    String?
  session      DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  // Where in the report they triggered
  context      String   // e.g. 'exec-summary', 'revenue-engine', 'simulator'
  
  // The user-supplied data
  email        String
  name         String?
  mobile       String?
  message      String?
  
  // Snapshot of master score at time of lead (for advisor context)
  masterScore  Float?
  tier         Tier?
  
  // Lead lifecycle
  status       LeadStatus @default(NEW)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([status, createdAt])
  @@map("advisor_leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

// PAYMENTS · Stripe transactions
model Payment {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripePaymentIntentId String   @unique
  stripeSessionId       String?  @unique
  
  amountCents           Int
  currency              String   @default("usd")
  tier                  Tier     // tier they bought
  
  status                PaymentStatus @default(PENDING)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// EXPANSION ASSESSMENT · stores results from the Global Scale-Up Readiness Navigator
model ExpansionAssessment {
  id             String   @id @default(cuid())

  // Optional auth link — anonymous assessments are stored without userId
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Input profile
  company        String
  hq             String   @default("India")
  industry       String
  revenue        String   @default("")
  model          String   @default("")
  targetGeos     Json     @default("[]")  // string[] — country codes
  goal           String   @default("")

  // Computed results
  readinessScore Int
  cluster        String   // Scale-Ready | Expansion-Ready | Preparation-Stage | Foundation-Stage
  topCountries   Json     @default("[]")  // { code, score, name, flag }[]
  revProjection  Json     @default("{}")  // { low, base, high }
  nextMoves      Json     @default("[]")  // { title, desc, when }[]

  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@map("expansion_assessments")
}

// MATCH REQUEST · stores a matchmaking run (profile + intent + results)
model MatchRequest {
  id            String   @id @default(cuid())

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Step 1 — company profile
  company       String
  hq            String   @default("India")
  sector        String
  stage         String
  revenue       String
  description   String   @default("")

  // Step 2 — intent
  intents       Json     @default("[]")  // string[] e.g. ["investor","distributor"]
  geos          Json     @default("[]")  // string[] e.g. ["DACH","UK"]
  priorities    Json     @default("[]")  // string[]
  notes         String   @default("")

  // Results (set on completion)
  matchCount    Int      @default(0)
  aiRead        String   @default("")
  geoBreakdown  Json     @default("[]")  // { geo, count }[]
  typeBreakdown Json     @default("[]")  // { type, count }[]
  matches       Json     @default("[]")  // anonymised match cards

  status        MatchStatus @default(PENDING)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("match_requests")
}

enum MatchStatus {
  PENDING
  COMPLETE
}

// DISCOVERY CALL BOOKING · from the "Book Discovery Call" modal
model DiscoveryCall {
  id            String   @id @default(cuid())
  matchRequestId String?
  name          String
  email         String
  preferredTime String   @default("")
  status        String   @default("requested")
  createdAt     DateTime @default(now())

  @@map("discovery_calls")
}
