# ─────────────────────────────────────────────────────────────
# WINGROX BACKEND · ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database
# Local: postgresql://user:pass@localhost:5432/wingrox
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Neon:     postgresql://[user]:[pass]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wingrox

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=30d

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
# ─────────────────────────────────────────────────────────────
# STRIPE_ENABLED=false  → payments bypass Stripe and upgrade users directly
#                         (use this during dev/beta testing — no card needed)
# STRIPE_ENABLED=true   → real Stripe checkout; requires all keys below
# ─────────────────────────────────────────────────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_VANGUARD_PRICE_ID=price_xxx
STRIPE_EXPANSION_GOLD_PRICE_ID=price_xxx
STRIPE_EXPANSION_PLATINUM_PRICE_ID=price_xxx

# Email/notification (optional for MVP — we use a Slack webhook for leads)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# File uploads
# 'local' for dev (saves to ./uploads), 's3' for production
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# S3 (only if UPLOAD_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=wingrox-uploads

# Advisor email (where leads get cc'd)
ADVISOR_EMAIL=advisor@wingrox.ai
