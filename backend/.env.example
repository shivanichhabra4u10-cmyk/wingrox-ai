# Backend Environment Variables
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database
DATABASE_URL=postgresql://wingrox:wingrox_dev@localhost:5432/wingrox_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=wingrox

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
STREAM_JWT_SECRET=your-stream-only-jwt-secret-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
